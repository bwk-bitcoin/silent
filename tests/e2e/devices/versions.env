# Pins for tests/e2e/devices/run.sh.
#
# The three Ledger values are bwk-hwi's hwi/tests/speculos/versions.env and must move
# with it: one app version, builder image and Speculos image for every Ledger test.
LEDGER_APP_VERSION=2.4.6
LEDGER_APP_BUILDER_IMAGE=ghcr.io/ledgerhq/ledger-app-builder/ledger-app-builder-lite@sha256:9f6f8779096e551dac8ba080227ec21287f286d1866f2dee0929e21dbb480dd0
SPECULOS_IMAGE=ghcr.io/ledgerhq/speculos@sha256:028d1e368244631578537e7ca50b6f13ca2932b5f3fd220627289b559c07a886
LEDGER_MODEL=nanosp

# The Coldcard EDGE firmware whose unix simulator runs key C (bwk-hwi phases 28 to 30).
COLDCARD_FIRMWARE_REPO=https://github.com/Coldcard/firmware.git
COLDCARD_FIRMWARE_COMMIT=04e949d68f2d753e2be4593d29b2b8d89345d31e
CKCC_PROTOCOL_VERSION=1.6.0

# Key A is a hot key in silent, B the Ledger on Speculos, C the Coldcard simulator.
SEED_A="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"
SEED_B="legal winner thank year wave sausage worth useful legal winner thank yellow"
SEED_C="letter advice cage absurd amount doctor acoustic avoid letter advice cage above"
